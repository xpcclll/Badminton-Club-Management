<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:else>
    <view wx:if="{{activities.length === 0}}" class="empty">暂无活动</view>

    <view
      wx:for="{{activities}}"
      wx:key="_id"
      class="card"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <view class="row-between">
        <view class="title">{{item.title}}</view>
        <view class="tag tag-{{item.status}}">{{item.statusLabel}}</view>
      </view>
      <view class="meta">{{item.dateLabel}} {{item.startTime}}-{{item.endTime}}</view>
      <view class="meta">{{item.location}}</view>
      <view class="meta">场地 {{item.courts.length}} 个 · 已报名 {{item.signupCount}}/{{item.capacity}} 人<text wx:if="{{item.waitingCount}}"> · 候补 {{item.waitingCount}}</text></view>
    </view>
  </block>

  <view wx:if="{{isAdmin}}" class="fab" bindtap="goCreate">＋ 创建活动</view>
</view>
