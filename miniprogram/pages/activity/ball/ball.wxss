.page {
  padding-bottom: 40rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 36rpx;
}

.step-num {
  min-width: 120rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

