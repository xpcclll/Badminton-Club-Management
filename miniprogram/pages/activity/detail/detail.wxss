.page {
  padding-bottom: 60rpx;
}

.header .meta {
  margin-top: 10rpx;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member:last-child {
  border-bottom: none;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.plus {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #e6f6ef;
  color: #1f8f6b;
  border-radius: 50%;
  margin-left: 20rpx;
  font-size: 28rpx;
}

.del {
  color: #d9534f;
  font-size: 24rpx;
  margin-left: 20rpx;
}

.admin-bar {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.present-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #e6f6ef;
  color: #1f8f6b;
  font-size: 22rpx;
  margin-left: 12rpx;
}

.checkin-btn {
  background: #1f8f6b;
  color: #fff;
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.mini-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #e6f6ef;
  color: #1f8f6b;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.mini-del {
  background: #fdeaea;
  color: #d9534f;
}

.waiting {
  color: #b8860b;
  font-size: 24rpx;
  margin-top: 8rpx;
}
