.page {
  padding-bottom: 60rpx;
}

.header .meta {
  margin-top: 10rpx;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member:last-child {
  border-bottom: none;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.plus {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #e6f6ef;
  color: #1f8f6b;
  border-radius: 50%;
  margin-left: 20rpx;
  font-size: 28rpx;
}

.del {
  color: #d9534f;
  font-size: 24rpx;
  margin-left: 20rpx;
}

.admin-bar {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

