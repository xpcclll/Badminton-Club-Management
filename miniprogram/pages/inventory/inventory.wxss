.page {
  padding-bottom: 40rpx;
}

.stock-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #1f8f6b;
}

.stock-num.low {
  color: #d9534f;
}

.low-tip {
  color: #d9534f;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}
