<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'me' ? 'active' : ''}}" data-tab="me" bindtap="switchTab">我的</view>
    <view wx:if="{{isAdmin}}" class="tab {{tab === 'overall' ? 'active' : ''}}" data-tab="overall" bindtap="switchTab">全员</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{tab === 'me'}}">
    <view class="card">
      <view class="row-between"><view>参加活动</view><view class="strong">{{my.signupCount || 0}} 次</view></view>
      <view class="row-between"><view>累计用球</view><view class="strong">{{my.totalBalls || 0}} 颗</view></view>
      <view class="row-between"><view>累计分摊</view><view class="strong">¥{{my.totalSpend || '0.00'}}</view></view>
    </view>

    <view class="card">
      <view class="subtitle">参与记录</view>
      <view wx:if="{{!my.activities || my.activities.length === 0}}" class="muted">暂无记录</view>
      <view wx:for="{{my.activities}}" wx:key="key" class="cell">
        <view>{{item.activity.title}}</view>
        <view>¥{{item.share}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'overall'}}">
    <view class="card">
      <view class="subtitle">成员汇总</view>
      <view wx:if="{{overall.length === 0}}" class="muted">暂无成员</view>
      <view wx:for="{{overall}}" wx:key="openid" class="cell">
        <view>
          <view>{{item.nickName || '成员'}}</view>
          <view class="muted">{{item.role === 'admin' ? '管理员' : '成员'}}</view>
        </view>
        <view class="text-right">
          <view>{{item.activities}} 次</view>
          <view class="muted">{{item.balls}} 球 · ¥{{item.spend}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
